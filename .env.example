# Set to the actual preview URL on previews. Configure the canonical domain only
# after DNS and production approval. No credentials are needed for the website.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false for draft deployments; enable only after publication review.
SITE_INDEXABLE=false

# ID do formulário publicado no HubSpot para recebimento via Forms API.
# O formulário deve incluir email, firstname, lastname, phone, company e message.
# O consentimento para tratamento de dados deve estar configurado no formulário.
HUBSPOT_FORM_GUID=
